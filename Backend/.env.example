# Copy to Backend/.env; use a dedicated SQL login with NeuroHirePaymentReviewAppRole.
SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=NeuroLanceHubDB
SQL_USER=neurohire_payment_app
SQL_PASSWORD=replace_with_local_app_password
SQL_ENCRYPT=true
# Only true for a local development SQL Server with a self-signed certificate.
SQL_TRUST_CERTIFICATE=true
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
NODE_ENV=development
# Server-controlled commission in basis points: 1000 = 10%.
PLATFORM_FEE_BPS=1000
